---
import { getEntry } from 'astro:content';

type Language = 'en' | 'es' | 'de';
interface Props { lang: Language }

const { lang } = Astro.props;
const profile = await getEntry('profile', 'site');
if (!profile) throw new Error('Missing src/content/profile/site.yaml');
const data = profile.data;

const pathFor = (language: Language) => language === 'en' ? '/privacy/' : `/${language}/privacy/`;
const backHref = lang === 'en' ? '/' : `/${lang}/`;
const emailToken = '[[privacy-email]]';

const content = {
  en: {
    title: 'Privacy & Legal Notice',
    updated: 'Last updated: 27 July 2026',
    intro: 'This page combines the privacy information and legal notice for the professional landing page fadeev.eu.',
    privacyTitle: 'Privacy information',
    legalTitle: 'Legal notice',
    emailFallback: 'Show email address',
    privacySections: [
      ['Controller', `The controller responsible for this website is Oleg Fadeev. Contact for privacy requests: ${emailToken}.`],
      ['Data collected through the contact form', 'When you send a message, the website asks for your name, email address and message text. These details are needed to reply to your enquiry.'],
      ['Purpose and legal basis', 'The data is processed to respond to your enquiry and to protect the contact form from spam and abuse. The legal basis is legitimate interest in responding to incoming professional enquiries and, where applicable, steps prior to entering into a contract.'],
      ['Service providers', 'The contact form is processed by Formspree, which receives the submitted form data, stores the submission in its dashboard and forwards the message by email. Cloudflare Turnstile is used to verify that the form is not being submitted by an automated bot. Your email provider may also process and store the resulting email message.'],
      ['International transfers', 'Some service providers may process technical or form data outside the European Economic Area. Where required, this is handled through the providers’ own data protection frameworks, contractual safeguards or applicable transfer mechanisms.'],
      ['Storage period', 'Contact messages are kept only for as long as needed to reply and manage the professional enquiry, normally up to 12 months after the last contact, unless a longer retention period is required for legal, contractual or legitimate business reasons.'],
      ['Your rights', `You may request access, rectification, deletion, restriction of processing or object to processing by contacting ${emailToken}. You may also lodge a complaint with your local data protection authority.`],
      ['Cookies and tracking', 'This website does not use advertising cookies or marketing analytics. Cloudflare Turnstile may process technical browser data for security and anti-spam purposes.'],
    ],
    legalSections: [
      ['Website owner', 'Oleg Fadeev'],
      ['Contact', `Email: ${emailToken}`],
      ['Professional activity', 'SAP S/4HANA FICO / FSCM consulting and finance transformation services.'],
      ['Address', 'Vogesenstrasse 33, 4056 Basel, Switzerland.'],
      ['VAT', 'No VAT number.'],
      ['Liability for content', 'The information on this website is provided for general professional information. Although reasonable care is taken, no guarantee is given that all information is complete, accurate or up to date.'],
      ['External links', 'This website may link to external services such as LinkedIn. The owner is not responsible for the content or privacy practices of external websites.'],
    ],
    back: 'Back to website',
    language: 'Language',
  },
  es: {
    title: 'Privacidad y aviso legal',
    updated: 'Última actualización: 27 de julio de 2026',
    intro: 'Esta página combina la información de privacidad y el aviso legal de la landing page profesional fadeev.eu.',
    privacyTitle: 'Información de privacidad',
    legalTitle: 'Aviso legal',
    emailFallback: 'Mostrar dirección de correo',
    privacySections: [
      ['Responsable del tratamiento', `El responsable de este sitio web es Oleg Fadeev. Contacto para solicitudes de privacidad: ${emailToken}.`],
      ['Datos recogidos mediante el formulario', 'Al enviar un mensaje, el sitio solicita tu nombre, dirección de correo electrónico y texto del mensaje. Estos datos son necesarios para responder a tu consulta.'],
      ['Finalidad y base jurídica', 'Los datos se tratan para responder a tu consulta y proteger el formulario frente a spam y abusos. La base jurídica es el interés legítimo en responder a consultas profesionales entrantes y, en su caso, la aplicación de medidas precontractuales.'],
      ['Proveedores de servicios', 'El formulario se procesa mediante Formspree, que recibe los datos enviados, guarda la solicitud en su panel y reenvía el mensaje por email. Cloudflare Turnstile se usa para verificar que el formulario no lo envía un bot. El proveedor de correo electrónico también puede procesar y almacenar el mensaje resultante.'],
      ['Transferencias internacionales', 'Algunos proveedores pueden tratar datos técnicos o del formulario fuera del Espacio Económico Europeo. Cuando sea necesario, esto se gestiona mediante los marcos de protección de datos, garantías contractuales o mecanismos de transferencia aplicables de dichos proveedores.'],
      ['Plazo de conservación', 'Los mensajes de contacto se conservan solo durante el tiempo necesario para responder y gestionar la consulta profesional, normalmente hasta 12 meses después del último contacto, salvo que exista una obligación legal, contractual o un motivo legítimo para conservarlos durante más tiempo.'],
      ['Tus derechos', `Puedes solicitar acceso, rectificación, supresión, limitación u oposición al tratamiento escribiendo a ${emailToken}. También puedes presentar una reclamación ante tu autoridad de protección de datos.`],
      ['Cookies y seguimiento', 'Este sitio no utiliza cookies publicitarias ni analítica de marketing. Cloudflare Turnstile puede tratar datos técnicos del navegador con fines de seguridad y protección antispam.'],
    ],
    legalSections: [
      ['Titular del sitio web', 'Oleg Fadeev'],
      ['Contacto', `Email: ${emailToken}`],
      ['Actividad profesional', 'Consultoría SAP S/4HANA FICO / FSCM y servicios de transformación financiera.'],
      ['Dirección', 'Vogesenstrasse 33, 4056 Basel, Switzerland.'],
      ['VAT', 'Sin número de VAT/IVA.'],
      ['Responsabilidad por contenidos', 'La información del sitio se ofrece con fines profesionales generales. Aunque se procura mantenerla correctamente, no se garantiza que toda la información sea completa, exacta o actualizada.'],
      ['Enlaces externos', 'Este sitio puede enlazar a servicios externos como LinkedIn. El titular no se responsabiliza del contenido ni de las prácticas de privacidad de sitios externos.'],
    ],
    back: 'Volver al sitio',
    language: 'Idioma',
  },
  de: {
    title: 'Datenschutz und Impressum',
    updated: 'Zuletzt aktualisiert: 27. Juli 2026',
    intro: 'Diese Seite kombiniert die Datenschutzinformationen und das Impressum für die berufliche Landingpage fadeev.eu.',
    privacyTitle: 'Datenschutzinformationen',
    legalTitle: 'Impressum',
    emailFallback: 'E-Mail-Adresse anzeigen',
    privacySections: [
      ['Verantwortlicher', `Verantwortlich für diese Website ist Oleg Fadeev. Kontakt für Datenschutzanfragen: ${emailToken}.`],
      ['Über das Kontaktformular erhobene Daten', 'Beim Absenden einer Nachricht werden Ihr Name, Ihre E-Mail-Adresse und der Nachrichtentext abgefragt. Diese Angaben werden benötigt, um Ihre Anfrage zu beantworten.'],
      ['Zweck und Rechtsgrundlage', 'Die Daten werden verarbeitet, um Ihre Anfrage zu beantworten und das Kontaktformular vor Spam und Missbrauch zu schützen. Rechtsgrundlage ist das berechtigte Interesse an der Beantwortung beruflicher Anfragen sowie gegebenenfalls vorvertragliche Maßnahmen.'],
      ['Dienstleister', 'Das Kontaktformular wird über Formspree verarbeitet. Formspree erhält die übermittelten Formulardaten, speichert die Anfrage im Dashboard und leitet die Nachricht per E-Mail weiter. Cloudflare Turnstile wird verwendet, um zu prüfen, dass das Formular nicht automatisiert durch einen Bot abgesendet wird. Auch der E-Mail-Anbieter kann die resultierende Nachricht verarbeiten und speichern.'],
      ['Internationale Übermittlungen', 'Einige Dienstleister können technische Daten oder Formulardaten außerhalb des Europäischen Wirtschaftsraums verarbeiten. Soweit erforderlich, erfolgt dies über die Datenschutzrahmen, vertraglichen Garantien oder sonstigen zulässigen Übermittlungsmechanismen der Anbieter.'],
      ['Speicherdauer', 'Kontaktanfragen werden nur so lange aufbewahrt, wie es zur Beantwortung und Bearbeitung der beruflichen Anfrage erforderlich ist, in der Regel bis zu 12 Monate nach dem letzten Kontakt, sofern keine längere Aufbewahrung aus rechtlichen, vertraglichen oder berechtigten geschäftlichen Gründen erforderlich ist.'],
      ['Ihre Rechte', `Sie können Auskunft, Berichtigung, Löschung, Einschränkung der Verarbeitung oder Widerspruch gegen die Verarbeitung verlangen, indem Sie an ${emailToken} schreiben. Außerdem können Sie sich bei Ihrer zuständigen Datenschutzaufsichtsbehörde beschweren.`],
      ['Cookies und Tracking', 'Diese Website verwendet keine Werbe-Cookies und keine Marketing-Analyse. Cloudflare Turnstile kann technische Browserdaten zu Sicherheits- und Anti-Spam-Zwecken verarbeiten.'],
    ],
    legalSections: [
      ['Websiteinhaber', 'Oleg Fadeev'],
      ['Kontakt', `E-Mail: ${emailToken}`],
      ['Berufliche Tätigkeit', 'SAP S/4HANA FICO / FSCM Beratung und Finance-Transformation.'],
      ['Anschrift', 'Vogesenstrasse 33, 4056 Basel, Switzerland.'],
      ['MwSt./VAT', 'Keine VAT-Nummer.'],
      ['Haftung für Inhalte', 'Die Inhalte dieser Website dienen der allgemeinen beruflichen Information. Trotz sorgfältiger Erstellung wird keine Gewähr für Vollständigkeit, Richtigkeit oder Aktualität übernommen.'],
      ['Externe Links', 'Diese Website kann auf externe Dienste wie LinkedIn verlinken. Der Inhaber ist nicht für Inhalte oder Datenschutzpraktiken externer Websites verantwortlich.'],
    ],
    back: 'Zurück zur Website',
    language: 'Sprache',
  },
}[lang];

const pageTitle = `${content.title} | Oleg Fadeev`;
const canonical = new URL(pathFor(lang), data.siteUrl).toString();
const languageNames = { en: 'EN', es: 'ES', de: 'DE' } as const;
const allSections = [
  { title: content.privacyTitle, sections: content.privacySections },
  { title: content.legalTitle, sections: content.legalSections },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow" />
    <meta name="description" content={content.intro} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main class="legal-page">
      <article class="legal-card">
        <nav class="legal-top" aria-label="Legal navigation">
          <a href={backHref}>← {content.back}</a>
          <div class="legal-languages" aria-label={content.language}>
            {(['en','es','de'] as Language[]).map((language) => (
              <a href={pathFor(language)} aria-current={language === lang ? 'page' : undefined}>{languageNames[language]}</a>
            ))}
          </div>
        </nav>
        <p class="updated">{content.updated}</p>
        <h1>{content.title}</h1>
        <p class="intro">{content.intro}</p>
        {allSections.map((group) => (
          <section class="document-group">
            <h2 class="group-title">{group.title}</h2>
            {group.sections.map(([heading, text]) => {
              const parts = text.split(emailToken);
              return (
                <section class="document-section">
                  <h3>{heading}</h3>
                  <p>
                    {parts.map((part, index) => (
                      <Fragment>
                        {part}
                        {index < parts.length - 1 && (
                          <a
                            class="protected-email"
                            href="#email"
                            data-user="ycavirp"
                            data-domain="ue.veedaf"
                          >
                            {content.emailFallback}
                          </a>
                        )}
                      </Fragment>
                    ))}
                  </p>
                </section>
              );
            })}
          </section>
        ))}
      </article>
    </main>
    <script is:inline>
      document.querySelectorAll('.protected-email').forEach((link) => {
        const reverse = (value) => value.split('').reverse().join('');
        const email = `${reverse(link.dataset.user || '')}@${reverse(link.dataset.domain || '')}`;
        link.textContent = email;
        link.href = `mailto:${email}`;
      });
    </script>
  </body>
</html>

<style>
  :root { color-scheme: dark; --navy:#06152f; --card:#f6f9fc; --ink:#0a2853; --muted:#60799c; --blue:#1265cd; }
  * { box-sizing:border-box; }
  html { min-width:320px; background:var(--navy); }
  body { min-width:320px; margin:0; color:var(--ink); font-family:Manrope, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background:radial-gradient(circle at 12% 14%,rgba(52,151,255,.34),transparent 29rem),linear-gradient(125deg,#06152f 0%,#092e67 49%,#061630 100%); }
  .legal-page { min-height:100svh; display:grid; place-items:center; padding:clamp(18px,4vw,52px); }
  .legal-card { width:min(960px,100%); padding:clamp(24px,4vw,52px); border-radius:28px; background:var(--card); box-shadow:0 34px 90px rgba(1,11,31,.36); }
  .legal-top { display:flex; justify-content:space-between; align-items:center; gap:18px; margin-bottom:34px; }
  a { color:var(--blue); font-weight:800; text-decoration:none; }
  a:hover { text-decoration:underline; text-underline-offset:3px; }
  .protected-email { overflow-wrap:anywhere; }
  .legal-languages { display:flex; gap:8px; }
  .legal-languages a { display:grid; place-items:center; min-width:38px; min-height:34px; border:1px solid #d5e3f1; border-radius:10px; color:#315f90; font-size:.82rem; }
  .legal-languages a[aria-current="page"] { color:#fff; border-color:var(--blue); background:var(--blue); }
  .updated { margin:0 0 10px; color:#60799c; font-size:.82rem; font-weight:700; }
  h1 { margin:0; color:#0a2a59; font-size:clamp(2.1rem,5vw,4rem); line-height:.96; letter-spacing:-.07em; }
  .intro { margin:18px 0 34px; color:#456486; font-size:1.05rem; line-height:1.65; }
  .document-group { padding:26px 0 6px; border-top:1px solid #dce9f7; }
  .group-title { margin:0 0 4px; color:#0a2a59; font-size:1.45rem; letter-spacing:-.035em; }
  .document-section { padding:18px 0; border-top:1px solid #dce9f7; }
  .document-section:first-of-type { border-top:0; }
  h3 { margin:0 0 8px; color:#123d70; font-size:1.08rem; }
  p { margin:0; color:var(--muted); line-height:1.7; }
  @media (max-width:620px) { .legal-top { align-items:flex-start; flex-direction:column; } .legal-card { border-radius:22px; } }
</style>
