  html { min-width:320px; scroll-behavior:smooth; background:var(--navy); }
  body { min-width:320px; margin:0; color:var(--ink); font-family:Manrope,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; background:radial-gradient(circle at 12% 14%,rgba(52,151,255,.34),transparent 29rem),linear-gradient(125deg,#06152f 0%,#092e67 49%,#061630 100%); }
  .legal-page { min-height:100svh; display:grid; place-items:start center; padding:clamp(18px,4vw,52px); }
  .legal-card { width:min(1040px,100%); padding:clamp(24px,4vw,56px); border-radius:28px; background:var(--card); box-shadow:0 34px 90px rgba(1,11,31,.36); }
  .legal-top { display:flex; justify-content:space-between; align-items:center; gap:18px; margin-bottom:34px; }
  .legal-card a { color:var(--blue); font-weight:750; text-decoration:none; }
  .legal-card a:hover { text-decoration:underline; text-underline-offset:3px; }
  .protected-email { overflow-wrap:anywhere; }
  .legal-languages { display:flex; gap:8px; }
  .legal-languages a { display:grid; place-items:center; min-width:38px; min-height:34px; border:1px solid #d5e3f1; border-radius:10px; color:#315f90; font-size:.82rem; }
  .legal-languages a[aria-current="page"] { color:#fff; border-color:var(--blue); background:var(--blue); }
  .legal-content h1 { margin:0 0 14px; color:#0a2a59; font-size:clamp(2.25rem,5vw,4.4rem); line-height:.98; letter-spacing:-.065em; }
  .legal-content h2 { margin:44px 0 16px; padding-top:26px; border-top:1px solid #dce9f7; color:#0a2a59; font-size:clamp(1.45rem,2.5vw,2rem); letter-spacing:-.035em; }
  .legal-content h3 { margin:28px 0 10px; color:#123d70; font-size:1.12rem; }
  .legal-content p, .legal-content li { color:var(--muted); line-height:1.72; }
  .legal-content p { margin:0 0 16px; }
  .legal-content ul, .legal-content ol { padding-left:1.4rem; }
  .legal-content strong { color:#244c78; }
  .legal-content hr { margin:34px 0; border:0; border-top:1px solid #dce9f7; }
  .legal-content table { width:100%; margin:18px 0 26px; border-collapse:collapse; border:1px solid #cfdeed; font-size:.94rem; }
  .legal-content th, .legal-content td { padding:12px 14px; border:1px solid #cfdeed; vertical-align:top; text-align:left; color:var(--muted); line-height:1.55; }
  .legal-content th { color:#123d70; background:#eaf2fa; }
  .legal-content code { padding:.12rem .35rem; border-radius:6px; background:#e6eef7; }
  @media (max-width:720px) {
