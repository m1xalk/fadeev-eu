const titles = {
  en: 'Privacy & Legal Notice',
  es: 'Aviso legal y de privacidad',
  de: 'Impressum & Datenschutzerklärung',
};
const descriptions = {
  en: 'Legal notice, terms of use and privacy information for fadeev.eu.',
  es: 'Aviso legal, condiciones de uso e información sobre privacidad de fadeev.eu.',
  de: 'Impressum, Nutzungsbedingungen und Datenschutzinformationen für fadeev.eu.',
};
const canonical = new URL(pathFor(lang), data.siteUrl).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow" />
    <meta name="description" content={descriptions[lang]} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{titles[lang]} | Oleg Fadeev</title>
  </head>
  <body>
    <main class="legal-page">
      <article class="legal-card">
        <nav class="legal-top" aria-label="Legal navigation">
          <a href={backHref}>← {labels[lang].back}</a>
          <div class="legal-languages" aria-label={labels[lang].language}>
            {(['en','es','de'] as Language[]).map((language) => (
              <a href={pathFor(language)} aria-current={language === lang ? 'page' : undefined}>{languageNames[language]}</a>
            ))}
          </div>
        </nav>
        <div class="legal-content" set:html={documents[lang]} />
      </article>
    </main>
    <script is:inline>
      document.querySelectorAll('.protected-email').forEach((link) => {
        const reverse = (value) => value.split('').reverse().join('');
        const email = `${reverse(link.dataset.user || '')}@${reverse(link.dataset.domain || '')}`;
        link.textContent = email;
        link.href = `mailto:${email}`;
      });
    </script>
  </body>
</html>

<style is:global>
  :root { color-scheme: dark; --navy:#06152f; --card:#f6f9fc; --ink:#0a2853; --muted:#526d8f; --blue:#1265cd; }
