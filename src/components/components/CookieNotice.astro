---
type Language = 'en' | 'es' | 'de';
interface Props { lang: Language }
const { lang } = Astro.props;
const privacyHref = lang === 'en' ? '/privacy/' : `/${lang}/privacy/`;
const copy = {
  en: {
    title: 'Privacy notice',
    text: 'This website does not use advertising cookies. The contact form uses Formspree and Cloudflare Turnstile to send messages securely and protect against spam. Form submissions are processed only to reply to your enquiry.',
    more: 'Privacy & Legal Notice',
    accept: 'Got it',
  },
  es: {
    title: 'Aviso de privacidad',
    text: 'Este sitio no utiliza cookies publicitarias. El formulario usa Formspree y Cloudflare Turnstile para enviar mensajes de forma segura y protegerse del spam. Los mensajes se tratan solo para responder a tu consulta.',
    more: 'Privacidad y aviso legal',
    accept: 'Entendido',
  },
  de: {
    title: 'Datenschutzhinweis',
    text: 'Diese Website verwendet keine Werbe-Cookies. Das Kontaktformular nutzt Formspree und Cloudflare Turnstile, um Nachrichten sicher zu senden und Spam zu verhindern. Formulardaten werden nur zur Beantwortung Ihrer Anfrage verarbeitet.',
    more: 'Datenschutz und Impressum',
    accept: 'Verstanden',
  },
}[lang];
---

<div class="privacy-notice" data-privacy-notice hidden>
  <div class="privacy-notice__icon" aria-hidden="true">i</div>
  <div class="privacy-notice__content">
    <strong>{copy.title}</strong>
    <p>{copy.text}</p>
  </div>
  <div class="privacy-notice__actions">
    <a href={privacyHref}>{copy.more}</a>
    <button type="button" data-privacy-notice-accept>{copy.accept}</button>
  </div>
</div>

<script is:inline>
  (function () {
    const notice = document.querySelector('[data-privacy-notice]');
    const accept = document.querySelector('[data-privacy-notice-accept]');
    const key = 'fadeev_privacy_notice_v1';
    if (!notice || !accept) return;

    try {
      if (localStorage.getItem(key) !== 'accepted') {
        notice.hidden = false;
      }
    } catch (error) {
      notice.hidden = false;
    }

    accept.addEventListener('click', function () {
      try { localStorage.setItem(key, 'accepted'); } catch (error) {}
      notice.classList.add('privacy-notice--closing');
      window.setTimeout(function () { notice.hidden = true; }, 180);
    });
  })();
</script>

<style>
  .privacy-notice[hidden] { display:none !important; }
  .privacy-notice {
    position:fixed;
    left:50%;
    bottom:18px;
    z-index:1000;
    width:min(880px, calc(100vw - 28px));
    display:grid;
    grid-template-columns:auto minmax(0, 1fr) auto;
    gap:14px;
    align-items:center;
    padding:14px 15px;
    border:1px solid rgba(168,215,255,.22);
    border-radius:18px;
    color:#eaf7ff;
    background:rgba(5,25,56,.92);
    box-shadow:0 22px 58px rgba(0,0,0,.34), inset 0 1px 0 rgba(255,255,255,.06);
    backdrop-filter:blur(16px);
    transform:translateX(-50%);
    animation:privacyNoticeIn .22s ease-out both;
  }
  .privacy-notice--closing { animation:privacyNoticeOut .18s ease-in both; }
  .privacy-notice__icon {
    display:grid;
    place-items:center;
    width:32px;
    height:32px;
    border-radius:50%;
    color:#06152f;
    background:linear-gradient(135deg,#6bdcff,#2b8cff);
    font:800 .95rem Manrope, system-ui, sans-serif;
  }
  .privacy-notice__content strong {
    display:block;
    margin:0 0 3px;
    font-size:.82rem;
    letter-spacing:-.01em;
  }
  .privacy-notice__content p {
    margin:0;
    color:#b9d0e8;
    font-size:.72rem;
    line-height:1.45;
  }
  .privacy-notice__actions {
    display:flex;
    align-items:center;
    gap:10px;
    white-space:nowrap;
  }
  .privacy-notice__actions a {
    color:#9fd7ff;
    font-size:.72rem;
    font-weight:800;
    text-decoration:none;
  }
  .privacy-notice__actions a:hover { color:#fff; text-decoration:underline; text-underline-offset:3px; }
  .privacy-notice__actions button {
    min-height:36px;
    padding:0 14px;
    border:0;
    border-radius:11px;
    color:#fff;
    background:linear-gradient(135deg,#258eff,#1265cd);
    font:800 .72rem Manrope, system-ui, sans-serif;
    cursor:pointer;
    box-shadow:0 10px 22px rgba(18,101,205,.28);
  }
  .privacy-notice__actions button:hover { filter:brightness(1.06); }
  @keyframes privacyNoticeIn { from { opacity:0; transform:translate(-50%, 10px); } to { opacity:1; transform:translate(-50%, 0); } }
  @keyframes privacyNoticeOut { from { opacity:1; transform:translate(-50%, 0); } to { opacity:0; transform:translate(-50%, 8px); } }
  @media (max-width:720px) {
    .privacy-notice {
      grid-template-columns:1fr;
      align-items:start;
      padding:14px;
    }
    .privacy-notice__icon { display:none; }
    .privacy-notice__actions { justify-content:space-between; }
  }
</style>
